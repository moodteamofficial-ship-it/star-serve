# Application
APP_NAME=Star Serve
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Database — portable PostgreSQL (Supabase / Cloud SQL / RDS / local)
# Secrets stay server-side only. Never put DATABASE_URL in VITE_* vars.
# APP_ENV selects DATABASE_URL_<ENV> when set; otherwise DATABASE_URL is used.
# -----------------------------------------------------------------------------
DB_PROVIDER=auto
# Public project ref (safe in logs / meta) — not a secret
SUPABASE_PROJECT_REF=wbasegyvtchdmkfkyoei
SUPABASE_URL=https://wbasegyvtchdmkfkyoei.supabase.co
# Backend-only secrets (Secret Manager in prod). NEVER put these in VITE_* or commit real values.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local default (single DB). Prefer per-plane DSNs below for staging / live / backup.
DATABASE_URL=postgresql+asyncpg://starserve:starserve@localhost:5432/starserve_staging

# Isolated env DSNs (recommended). Separate databases — never an is_staging column.
# Local docker: staging :8000, live :8001, backup :8002
# DATABASE_URL_DEVELOPMENT=postgresql+asyncpg://starserve:starserve@localhost:5432/starserve_staging
# DATABASE_URL_STAGING=postgresql+asyncpg://starserve:starserve@localhost:5432/starserve_staging
# DATABASE_URL_PRODUCTION=postgresql+asyncpg://starserve:starserve@localhost:5432/starserve_live
# DATABASE_URL_BACKUP=postgresql+asyncpg://starserve:starserve@localhost:5432/starserve_backup
# Supabase / Cloud SQL: use separate projects or instances per plane.
# DATABASE_URL_DEVELOPMENT=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL_STAGING=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL_PRODUCTION=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL_BACKUP=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Local docker api-live only — NEVER true on Cloud Run
# ALLOW_INSECURE_PRODUCTION=false

# Cloud Run (project star-serve-508614, region europe-west1):
#   ./scripts/gcp/bootstrap.sh
#   ./scripts/gcp/sync-secrets.sh staging && ./scripts/gcp/release.sh staging
# Secrets are uploaded to Secret Manager — never commit real values or bake them into the image.
# Staging Cloud Run uses APP_ENV=staging (dev-like). Production uses APP_ENV=production.
# Point the SPA at public URLs only (see frontend/.env.example / .env.cloud after deploy).
# Cloud Run: TRUST_X_FORWARDED_FOR=true COOKIE_SECURE=true COOKIE_SAMESITE=none

# Google Cloud SQL example (via Auth Proxy / Connector socket or private IP):
# DB_PROVIDER=cloud_sql
# DATABASE_URL=postgresql+asyncpg://starserve:SECRET@127.0.0.1:5432/starserve_prod

DATABASE_SCHEMA=public
# Keep pools small on Cloud Run; use NullPool with transaction poolers
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_COMMAND_TIMEOUT=30
DB_SSL_MODE=prefer
DB_NULL_POOL=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (dev placeholders — replace in production; prefer RS256 key pair)
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
# PEM contents may be multiline; use Secret Manager in production
JWT_PRIVATE_KEY_PATH=secrets/dev_jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/dev_jwt_public.pem

# Security
PASSWORD_HASHER=argon2
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_DEFAULT=120/minute
CSRF_SECRET=change-me-csrf-dev-only
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Encryption (Fernet key or 32-byte urlsafe base64)
ENCRYPTION_KEY=change-me-32-byte-encryption-key!!

# Proxy / host hardening
# Cloud Run / reverse proxy: TRUST_X_FORWARDED_FOR=true
# Direct Cloud Run: TRUSTED_PROXY_HOPS=1
# SPA nginx (starserve-dashboard-*) → API: TRUSTED_PROXY_HOPS=2
TRUST_X_FORWARDED_FOR=false
TRUSTED_PROXY_HOPS=1
ALLOWED_HOSTS=
# Production refuses manual wallet credit unless explicitly true
# ALLOW_MANUAL_WALLET_CREDIT=false
CERTIFICATE_DOWNLOAD_HOSTS=definiteassurance.com,blob.core.windows.net,azureedge.net

# Local seed only — never use 11111111. Required 12+ mixed chars.
SEED_ADMIN_PASSWORD=StarServeDev!2026

# External providers (Phase 3+) — never expose to frontend
DEFINITE_ASSURANCE_BASE_URL=https://uat.definiteassurance.com/api/v1
DEFINITE_ASSURANCE_USERNAME=
DEFINITE_ASSURANCE_PASSWORD=
DEFINITE_ASSURANCE_AGENT_CODE=
DEFINITE_ASSURANCE_TEST_AMOUNT_PAID=1
DEFINITE_ASSURANCE_TEST_PHONE=254700000001
DEFINITE_ASSURANCE_ENFORCE_DOUBLE_INSURANCE=false
DEFINITE_ASSURANCE_TIMEOUT_SECONDS=60
# LIVE example: https://digitalapi.definiteassurance.com/api/app/v1
# On LIVE set DEFINITE_ASSURANCE_ENFORCE_DOUBLE_INSURANCE=true

# BirdView STK (dev defaults to charging 1 KES — see BIRDVIEW_TEST_AMOUNT)
BIRDVIEW_LIVE=false
BIRDVIEW_TEST_AMOUNT=1
BIRDVIEW_STK_URL=https://payments.birdviewinsurance.com/mobile-payments/stk-push
# Optional: used when the branded host fails DNS on some ISPs
BIRDVIEW_STK_FALLBACK_URL=https://payments-ewrv.onrender.com/mobile-payments/stk-push
BIRDVIEW_CALLBACK_BASE_URL=
BIRDVIEW_WEBHOOK_SECRET=

# Email — Gmail SMTP when EMAIL_SMTP_PASSWORD is set (EMAIL_PROVIDER=auto).
# Use a Gmail App Password, not the Google account password.
# Consumer Gmail is capped (~100–500/day; Workspace ~2,000/day).
# For 200k+ use EMAIL_PROVIDER=sendgrid or ses and:
#   python -m app.modules.notifications.worker
EMAIL_PROVIDER=auto
EMAIL_FROM_NAME=Star Serve
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_REPLY_TO=
EMAIL_SUPPORT_ADDRESS=hello@yourdomain.com
EMAIL_SUPPORT_PHONE=
EMAIL_SUPPORT_HOURS=Monday – Friday, 8:00 AM – 5:00 PM EAT
EMAIL_LEGAL_LINE=Star Serve Insurance Agency · Nairobi, Kenya
EMAIL_APP_URL=http://localhost:5173
EMAIL_LOGO_URL=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false
# EMAIL_RATE_PER_SECOND=1
# EMAIL_MAX_CONNECTIONS=2
# EMAIL_WORKER_ENABLED=true
# EMAIL_DELIVER_INLINE=false
# EMAIL_PDF_STORAGE_DIR=data/email-pdfs

# Object storage — local data/ (dev) or private GCS (Cloud Run / Render API).
# Bucket stays non-public; runtime SA (Cloud Run) or GOOGLE_APPLICATION_CREDENTIALS (Render).
# STORAGE_BACKEND=local
# STORAGE_BACKEND=gcs
# GCS_BUCKET=star_serve
# GCS_PREFIX=staging
# SendGrid: EMAIL_PROVIDER=sendgrid EMAIL_API_KEY=...
# SES SMTP: EMAIL_PROVIDER=ses EMAIL_SES_REGION=eu-west-1 EMAIL_SMTP_USERNAME=... EMAIL_SMTP_PASSWORD=...

# TextSMS (sms.textsms.co.ke) — official SMS. Blank key/partner → local stub.
SMS_API_KEY=
SMS_PARTNER_ID=
SMS_API_URL=https://sms.textsms.co.ke/api/services/sendsms/
SMS_SENDER_ID=STARSERVE
# SMS_DELIVER_INLINE=false
WHATSAPP_API_TOKEN=

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend public (Vite) — API URLs ONLY, never database passwords / JWT / service keys
VITE_APP_NAME=Star Serve
VITE_DEFAULT_API_ENV=development
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Staging plane (api-staging)
VITE_API_URL_DEVELOPMENT=http://localhost:8000/api/v1
VITE_API_URL_STAGING=http://localhost:8000/api/v1
# Live plane (api-live) — must differ from staging for real isolation
VITE_API_URL_PRODUCTION=http://localhost:8001/api/v1
# Backup plane (api-backup) — restored / archival copy
VITE_API_URL_BACKUP=http://localhost:8002/api/v1
# Optional: skip confirm dialog when switching to live API
# VITE_ALLOW_PRODUCTION_ENV_SWITCH=false
