VITE_APP_NAME=Star Serve
# Localhost default: talk to local uvicorn. Deployed builds ignore Vite proxies.
VITE_DEFAULT_API_ENV=development
# Public API bases only — never DATABASE_URL, service role keys, or JWT PEMs.
VITE_API_BASE_URL=/api/v1
VITE_API_URL_DEVELOPMENT=/api/v1
VITE_API_URL_STAGING=/staging-api/v1
VITE_API_URL_PRODUCTION=/prod-api/v1
VITE_API_URL_BACKUP=/prod-api/v1
# Public welcome / dashboard origins used in agent QR codes (not localhost).
# VITE_WEB_URL_STAGING=https://starserve-dashboard-staging-233389149626.europe-west1.run.app
# VITE_WEB_URL_PRODUCTION=https://quote.starserveinsuranceagency.com/dashboard
# Local Vite proxy targets (vite.config.ts) — localhost only.
# DEV_PROXY_LOCAL=http://127.0.0.1:8000
# DEV_PROXY_STAGING=https://starserve-api-staging-233389149626.europe-west1.run.app
# DEV_PROXY_PRODUCTION=https://starserve-api.onrender.com
