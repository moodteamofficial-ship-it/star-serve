# StarServe SPA on Cloud Run — static assets + same-origin API proxy.
# Variables substituted at container start: ${PORT} ${API_UPSTREAM}

worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  keepalive_timeout 65;
  client_max_body_size 32m;
  server_tokens off;

  client_body_temp_path /tmp/client_temp;
  proxy_temp_path       /tmp/proxy_temp;
  fastcgi_temp_path     /tmp/fastcgi_temp;
  uwsgi_temp_path       /tmp/uwsgi_temp;
  scgi_temp_path        /tmp/scgi_temp;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  map $http_x_forwarded_for $starserve_xff {
    default $http_x_forwarded_for;
    ""      $remote_addr;
  }

  log_format main '$remote_addr - $request $status $body_bytes_sent';
  access_log /dev/stdout main;

  upstream starserve_api {
    server ${API_UPSTREAM}:443;
    keepalive 16;
  }

  server {
    listen ${PORT} default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; media-src 'self' blob:" always;

    location = /ready {
      access_log off;
      default_type text/plain;
      return 200 'ok';
    }

    location /api/ {
      proxy_http_version 1.1;
      proxy_set_header Host ${API_UPSTREAM};
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $starserve_xff;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Connection "";
      proxy_ssl_server_name on;
      proxy_ssl_name ${API_UPSTREAM};
      proxy_pass https://starserve_api;
      proxy_read_timeout 180s;
      proxy_send_timeout 180s;
      proxy_connect_timeout 30s;
      proxy_buffering off;
    }

    location = /health {
      proxy_http_version 1.1;
      proxy_set_header Host ${API_UPSTREAM};
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Connection "";
      proxy_ssl_server_name on;
      proxy_ssl_name ${API_UPSTREAM};
      proxy_pass https://starserve_api/health;
      proxy_read_timeout 30s;
    }

    location ~* ^/assets/.*\.mjs$ {
      default_type application/javascript;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "DENY" always;
      try_files $uri =404;
    }

    location ~* ^/assets/.*\.js$ {
      default_type application/javascript;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "DENY" always;
      try_files $uri =404;
    }

    location /assets/ {
      try_files $uri =404;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      add_header X-Frame-Options "DENY" always;
      add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
      try_files $uri $uri/ /index.html;
      add_header Cache-Control "no-cache" always;
      add_header X-Frame-Options "DENY" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;
      add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
      add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; media-src 'self' blob:" always;
    }
  }
}
